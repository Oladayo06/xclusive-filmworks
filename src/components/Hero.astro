---

---

<section class="hero" id="top">
    <video
        class="hero-video"
        src="/videos/hero-reel3.mp4"
        autoplay
        muted
        loop
        playsinline></video>
    <div class="hero-overlay"></div>

    <div class="hero-content">
        <p class="hero-label">FILM · TELEVISION · BRAND & DIGITAL</p>
        <h1 class="hero-title">
            IDEAS THAT MOVE THE <span class="accent">WORLD</span>
        </h1>
        <p class="hero-sub">
            XCLUSIVE FILMWORKS is a film and TV production company with a vision
            of weaving truly distinctive fiction and non-fiction stories in the
            minds of people around the world through creative, excellent, and
            original film and TV productions.
        </p>
        <div class="hero-ctas">
            <a href="#trailers" class="btn-primary">▶ WATCH TRAILERS</a>
            <a href="/projects" class="btn-outline">SEE OUR PROJECTS</a>
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        padding: 0 24px;
    }

    .hero-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            180deg,
            rgba(10, 10, 10, 0.75) 0%,
            rgba(10, 10, 10, 0.55) 0%,
            rgba(10, 10, 10, 0.9) 10%
        );
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 820px;
    }

    .hero-label {
        color: var(--color-accent-filmworks);
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 13px;
        margin-bottom: 20px;
    }

    .hero-title {
        font-family: var(--font-heading);
        font-size: clamp(36px, 9vw, 110px);
        line-height: 1.1;
        font-weight: 700;
        margin-bottom: 24px;
    }

    .hero-title .accent {
        color: var(--color-accent-filmworks);
    }

    .hero-sub {
        opacity: 0.75;
        max-width: 560px;
        margin: 0 auto 36px;
        font-size: 15px;
        line-height: 1.6;
    }

    .hero-ctas {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-primary {
        background: var(--color-accent-filmworks);
        color: #fff;
        padding: 14px 28px;
        border-radius: 4px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .btn-outline {
        border: 1px solid rgba(255, 255, 255, 0.4);
        color: #fff;
        padding: 14px 28px;
        border-radius: 4px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }
    .btn-primary,
    .btn-outline {
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            background 0.25s ease,
            border-color 0.25s ease;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(204, 0, 0, 0.4);
    }

    .btn-outline:hover {
        border-color: var(--color-accent-filmworks);
        background: rgba(204, 0, 0, 0.08);
        transform: translateY(-2px);
    }
</style>
