---
import { getRecentProjects } from "../lib/queries";
import ProjectVideoModal from "./ProjectVideoModal.tsx";
import FadeInSection from "./FadeInSection.tsx";

const projects = await getRecentProjects(6);
---

<FadeInSection client:visible>
  <section class="projects">
    <p class="section-label">● Recent Productions / 03</p>
    <h2>RECENT PRODUCTIONS.</h2>

    <div class="projects-grid">
      {
        projects.map((p) => (
          <div
            class="project-card"
            style={p.posterUrl ? `background-image: url(${p.posterUrl})` : ""}
          >
            <div class="project-overlay" />

            {p.videoUrl && (
              <div class="project-play">
                <ProjectVideoModal
                  client:load
                  videoUrl={p.videoUrl}
                  title={p.title}
                />
              </div>
            )}

            <div class="project-info">
              <h3>{p.title}</h3>
              <p>
                {p.client} · {p.year}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <a href="/projects" class="view-all-btn">→ VIEW ALL PROJECTS</a>
  </section>
</FadeInSection>

<style>
  .projects {
    padding: var(--section-padding-y) var(--section-padding-x);
  }

  .section-label {
    color: var(--color-accent-filmworks);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  .project-card {
    position: relative;
    aspect-ratio: 16 / 10;
    background-color: #111;
    background-size: cover;
    background-position: center;
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 40%,
      rgba(0, 0, 0, 0.85) 100%
    );
  }

  .project-info {
    position: relative;
    z-index: 2;
    padding: 20px;
  }

  .project-info h3 {
    font-family: var(--font-heading);
    font-size: 20px;
    margin: 0 0 4px;
  }

  .project-info p {
    opacity: 0.7;
    font-size: 13px;
    margin: 0;
  }

  .project-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 3;
  }

  .project-card:hover .project-play {
    opacity: 1;
  }

  .view-all-btn {
    display: inline-block;
    margin-top: 32px;
    background: var(--color-accent-filmworks);
    color: #fff;
    padding: 14px 28px;
    border-radius: 4px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
