---
interface Props {
    src: string;
}

const { src } = Astro.props;
---

<div class="loop-card">
    <video class="loop-video" src={src} autoplay muted loop playsinline></video>
</div>

<style>
    .loop-card {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 5;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid rgba(201, 164, 99, 0.25);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    }

    .loop-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(10%);
    }
</style>
