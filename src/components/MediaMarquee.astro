---
const items = [
    { label: "Scriptwriting", image: "/images/marquee/scriptwriting.jpg" },
    { label: "Sound Design", image: "/images/marquee/sound-design.jpg" },
    { label: "Color Grading", image: "/images/marquee/color-grading.jpg" },
    { label: "Motion Graphics", image: "/images/marquee/motion-graphics.jpg" },
    { label: "Brand Strategy", image: "/images/marquee/brand-strategy.jpg" },
    { label: "Content Design", image: "/images/marquee/content-design.jpg" },
];
---

<section class="media-marquee">
    <div class="marquee-track">
        {
            items.map((item) => (
                <>
                    <div class="item">
                        <img
                            class="item-bg"
                            src={item.image}
                            alt=""
                            aria-hidden="true"
                        />
                        <div class="item-overlay" />
                        <span class="item-label">{item.label}</span>
                    </div>
                    <span class="dot">●</span>
                </>
            ))
        }
        {
            items.map((item) => (
                <>
                    <div class="item">
                        <img
                            class="item-bg"
                            src={item.image}
                            alt=""
                            aria-hidden="true"
                        />
                        <div class="item-overlay" />
                        <span class="item-label">{item.label}</span>
                    </div>
                    <span class="dot">●</span>
                </>
            ))
        }
    </div>
</section>

<style>
    .media-marquee {
        overflow: hidden;
        background: #1a1a1a;
        padding: 28px 0;
    }

    .marquee-track {
        display: flex;
        align-items: center;
        gap: 32px;
        width: max-content;
        animation: scroll-media 22s linear infinite;
    }

    .item {
        position: relative;
        display: flex;
        align-items: center;
        padding: 20px 32px;
        border-radius: 8px;
        overflow: hidden;
        flex-shrink: 0;
        isolation: isolate;
    }

    .item-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transform: scale(1.1);
        transition:
            opacity 0.35s ease,
            transform 0.6s ease;
        z-index: 0;
    }

    .item-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            90deg,
            rgba(10, 10, 10, 0.85) 0%,
            rgba(10, 10, 10, 0.55) 100%
        );
        opacity: 0;
        transition: opacity 0.35s ease;
        z-index: 1;
    }

    .item:hover .item-bg,
    .item:hover .item-overlay {
        opacity: 1;
    }

    .item:hover .item-bg {
        transform: scale(1);
    }

    .item-label {
        position: relative;
        z-index: 2;
        font-family: var(--font-heading);
        font-size: clamp(22px, 3vw, 38px);
        color: rgba(255, 255, 255, 0.5);
        transition: color 0.3s ease;
        white-space: nowrap;
    }

    .item:hover .item-label {
        color: #fff;
    }

    .dot {
        color: var(--color-accent-media);
        font-size: 10px;
        flex-shrink: 0;
        animation: pulse-dot 1.4s ease-in-out infinite;
    }

    @keyframes scroll-media {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
    }

    @keyframes pulse-dot {
        0%,
        100% {
            opacity: 0.35;
            transform: scale(0.85);
        }
        50% {
            opacity: 1;
            transform: scale(1.2);
        }
    }
</style>
