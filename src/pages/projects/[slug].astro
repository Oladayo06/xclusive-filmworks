---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjectBySlug } from "../../lib/queries";
import ProjectVideoModal from "../../components/ProjectVideoModal.tsx";

const { slug } = Astro.params;
const project = slug ? await getProjectBySlug(slug) : null;

if (!project) {
    return Astro.redirect("/projects");
}
---

<BaseLayout
  title={`${project.title} — Xclusive Filmworks`}
  description={project.description || `${project.title}, a ${project.category} by Xclusive Filmworks.`}
  image={project.posterUrl}
>
    <section
        class="project-hero"
        style={project.posterUrl
            ? `background-image: url(${project.posterUrl})`
            : ""}
    >
        <div class="project-hero-overlay"></div>

        <div class="project-hero-content">
            <a href="/projects" class="back-link">← Back to Archive</a>
            <p class="project-category">{project.category}</p>
            <h1 class="project-title">{project.title}</h1>
            <p class="project-meta">{project.client} · {project.year}</p>

            {
                project.videoUrl && (
                    <div class="project-hero-play">
                        <ProjectVideoModal
                            client:load
                            videoUrl={project.videoUrl}
                            title={project.title}
                            accentColor="#CC0000"
                        />
                        <span class="play-label">Watch Trailer</span>
                    </div>
                )
            }
        </div>
    </section>

    <section class="project-body">
        <div class="project-body-grid">
            <div class="project-description">
                <p class="label">Synopsis</p>
                <p>
                    {project.description || "Full project details coming soon."}
                </p>
            </div>

            {
                project.services && project.services.length > 0 && (
                    <div class="project-services">
                        <p class="label">Services Delivered</p>
                        <ul>
                            {project.services.map((s: string) => (
                                <li>{s}</li>
                            ))}
                        </ul>
                    </div>
                )
            }
        </div>

        {
            project.galleryUrls && project.galleryUrls.length > 0 && (
                <div class="project-gallery">
                    {project.galleryUrls.map((url: string) => (
                        <div
                            class="gallery-item"
                            style={`background-image: url(${url})`}
                        />
                    ))}
                </div>
            )
        }
    </section>

    <section class="project-cta">
        <h2>Have A Project In Mind?</h2>
        <a href="/contact" class="cta-btn">Start A Conversation →</a>
    </section>
</BaseLayout>

<style>
    .project-hero {
        position: relative;
        min-height: 70vh;
        display: flex;
        align-items: flex-end;
        padding: 180px var(--section-padding-x) 64px;
        background-size: cover;
        background-position: center;
        background-color: #111;
    }

    .project-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            180deg,
            rgba(10, 10, 10, 0.5) 0%,
            rgba(10, 10, 10, 0.95) 100%
        );
    }

    .project-hero-content {
        position: relative;
        z-index: 1;
        max-width: 800px;
    }

    .back-link {
        display: inline-block;
        color: var(--color-text);
        opacity: 0.6;
        text-decoration: none;
        font-size: 13px;
        margin-bottom: 24px;
        transition: opacity 0.25s ease;
    }

    .back-link:hover {
        opacity: 1;
    }

    .project-category {
        color: var(--color-accent-filmworks);
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 12px;
        margin-bottom: 12px;
    }

    .project-title {
        font-family: var(--font-heading);
        font-size: clamp(36px, 7vw, 76px);
        line-height: 1;
        margin-bottom: 12px;
    }

    .project-meta {
        opacity: 0.65;
        font-size: 14px;
        margin-bottom: 32px;
    }

    .project-hero-play {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .play-label {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.8;
    }

    .project-body {
        padding: 80px var(--section-padding-x);
    }

    .project-body-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 64px;
        margin-bottom: 64px;
    }

    .label {
        color: var(--color-accent-filmworks);
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 12px;
        margin-bottom: 16px;
    }

    .project-description p {
        opacity: 0.8;
        font-size: 16px;
        line-height: 1.8;
        max-width: 640px;
    }

    .project-services ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .project-services li {
        opacity: 0.75;
        font-size: 14px;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .project-gallery {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .gallery-item {
        aspect-ratio: 4 / 3;
        border-radius: 6px;
        background-color: #111;
        background-size: cover;
        background-position: center;
    }

    .project-cta {
        text-align: center;
        padding: 100px var(--section-padding-x);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .project-cta h2 {
        font-family: var(--font-heading);
        font-size: clamp(28px, 4vw, 48px);
        margin-bottom: 32px;
    }

    .cta-btn {
        display: inline-block;
        background: var(--color-accent-filmworks);
        color: #fff;
        padding: 16px 32px;
        border-radius: 4px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease;
    }

    .cta-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(204, 0, 0, 0.4);
    }

    @media (max-width: 900px) {
        .project-body-grid {
            grid-template-columns: 1fr;
            gap: 32px;
        }

        .project-gallery {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
