---
import SEO from '../components/SEO.astro'
import "../styles/global.css";
import MediaHeader from "../components/MediaHeader.astro";
import MediaHero from "../components/MediaHero.astro";
import MediaMarquee from "../components/MediaMarquee.astro";
import ServicesAccordion from "../components/ServicesAccordion.tsx";
import MediaPhilosophy from "../components/MediaPhilosophy.astro";
import MediaWork from "../components/MediaWork.astro";
import MediaProcess from "../components/MediaProcess.astro";
import MediaWhy from "../components/MediaWhy.astro";
import MediaCTA from "../components/MediaCTA.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href="/favicons/favicon-gold.png" />
        <title>Xclusive Media — Brand & Digital</title>
        <SEO
            title="Xclusive Media — Brand & Digital"
            description="The brand and digital arm of Xclusive Filmworks — identity, content, and digital experiences for brands with a story to tell."
        />
    </head>
    <body>
        <MediaHeader />
        <MediaHero />
        <MediaMarquee />
        <ServicesAccordion client:visible />
        <MediaPhilosophy />
        <MediaWork />
        <MediaProcess />
        <MediaWhy />
        <MediaCTA />
        <Footer />
    </body>
</html>
